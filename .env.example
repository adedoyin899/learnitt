# ==============================================================================
# Learnitt Environment Variables (.env.example)
# Copy to .env.local for local development.
# In local/test mode, MOCK_MODE defaults to true so real API keys are not required.
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mode Flags
MOCK_MODE=

# AI Configuration (required only when MOCK_MODE=false)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_PROVIDER_KEY=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_PROVIDER_KEY=
DAILY_AI_CALL_CAP=
DAILY_USER_AI_CALL_CAP=

# External Providers (required only when MOCK_MODE=false)
SEARCH_PROVIDER_KEY=
EMAIL_PROVIDER_KEY=

# Push Notifications (required only when MOCK_MODE=false)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Internal Security
CRON_SECRET=
